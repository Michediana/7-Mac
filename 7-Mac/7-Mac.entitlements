<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shared with the Finder menu extension, which leaves here which of
	     its items was chosen. See FinderHandoff. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.michediana.Seven-Mac</string>
	</array>
	<!-- Remember a destination folder the user has allowed, so "extract next
	     to the archive" costs one panel rather than one per job. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Where downloaded archives actually live. Without this the most
	     common extraction of all -- a .zip in ~/Downloads -- would open a
	     folder panel before it could write anything. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- M2 writes: an extraction has to put files somewhere. M0 and M1 only
	     needed read-only. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Sparkle's installer XPC service, which replaces the app from outside
	     the sandbox. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
