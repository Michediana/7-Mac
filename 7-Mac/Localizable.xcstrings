    "7-Mac" : {

    },
    "7-Mac asks the first time it needs a folder, and remembers it. Allowing your home folder covers everything in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac fragt, wenn es einen Ordner zum ersten Mal braucht, und merkt ihn sich. Wenn du deinen Benutzerordner erlaubst, ist alles darin abgedeckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac pregunta la primera vez que necesita una carpeta y la recuerda. Permitir tu carpeta de inicio cubre todo lo que contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac demande la première fois qu’il a besoin d’un dossier, puis s’en souvient. Autoriser votre dossier de départ couvre tout ce qu’il contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac chiede la prima volta che gli serve una cartella e se la ricorda. Autorizzare la cartella Inizio copre tutto ciò che contiene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac vraagt het de eerste keer dat het een map nodig heeft en onthoudt die. Als je je thuismap toestaat, valt alles daarin eronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac pyta za pierwszym razem, gdy potrzebuje katalogu, i zapamiętuje go. Zezwolenie na katalog domowy obejmuje wszystko, co się w nim znajduje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 7-Mac pergunta na primeira vez que precisa de uma pasta e memoriza-a. Autorizar a sua pasta pessoal abrange tudo o que está dentro dela."
          }
        }
      }
    },
    "7-Mac did not receive any files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-Mac hat keine Dateien erhalten."
