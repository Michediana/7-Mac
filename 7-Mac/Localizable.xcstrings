    "Format, level, method, dictionary, solid blocks and threads are saved. A preset with the same name is replaced." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan el formato, el nivel, el método, el diccionario, los bloques sólidos y los hilos. Un preajuste con el mismo nombre se sustituye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, le niveau, la méthode, le dictionnaire, les blocs solides et les threads sont enregistrés. Un préréglage du même nom est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono salvati formato, livello, metodo, dizionario, blocchi solid e thread. Un preset con lo stesso nome viene sostituito."
          }
        }
      }
    },
