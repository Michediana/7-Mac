    "The container the menu and the app share cannot be written. The menu will do nothing; reinstalling 7-Mac should fix it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gemeinsame Container von Menü und App ist nicht beschreibbar. Das Menü wird nichts tun; eine Neuinstallation von 7-Mac sollte das beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede escribir en el contenedor que comparten el menú y la app. El menú no hará nada; reinstalar 7-Mac debería solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur partagé par le menu et l’app n’est pas accessible en écriture. Le menu ne fera rien ; réinstaller 7-Mac devrait régler le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contenitore condiviso da menu e app non è scrivibile. Il menu non farà nulla; reinstallare 7-Mac dovrebbe risolvere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De container die het menu en de app delen, is niet schrijfbaar. Het menu doet niets; 7-Mac opnieuw installeren zou het moeten oplossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można zapisywać w kontenerze współdzielonym przez menu i aplikację. Menu nie będzie działać; ponowna instalacja 7-Mac powinna to naprawić."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
