    "macOS asks you to allow this yourself: in System Settings, under Login Items & Extensions, turn on 7-Mac’s Finder extension, then come back here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS verlangt, dass du dies selbst erlaubst: Aktiviere in den Systemeinstellungen unter „Anmeldeobjekte & Erweiterungen“ die Finder-Erweiterung von 7-Mac und kehre dann hierher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pide que lo permitas tú: en Ajustes del Sistema, en Ítems de inicio y extensiones, activa la extensión del Finder de 7-Mac y vuelve aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vous demande de l’autoriser vous-même : dans Réglages Système, sous Ouverture et extensions, activez l’extension Finder de 7-Mac, puis revenez ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chiede che sia tu a consentirlo: in Impostazioni di Sistema, sotto Elementi login ed estensioni, attiva l’estensione Finder di 7-Mac, poi torna qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vraagt je dit zelf toe te staan: schakel in Systeeminstellingen, onder ‘Inlogonderdelen en extensies’, de Finder-extensie van 7-Mac in en kom dan hier terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wymaga Twojej zgody: w Ustawieniach systemowych, w sekcji Rzeczy otwierane podczas logowania i rozszerzenia, włącz rozszerzenie Findera 7-Mac, a następnie wróć tutaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pede que seja o próprio utilizador a autorizar isto: em Definições do Sistema, em Itens de início de sessão e extensões, ative a extensão do Finder do 7-Mac e depois volte aqui."
          }
        }
      }
    },
    "macOS did not let 7-Mac open these: %@. Try again from Settings › Opening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat 7-Mac nicht erlaubt, diese zu öffnen: %@. Versuche es erneut unter „Einstellungen“ › „Öffnen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que 7-Mac abra estos: %@. Vuelve a intentarlo desde Ajustes › Abriendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas laissé 7-Mac ouvrir ceux-ci : %@. Réessayez depuis Réglages › Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha permesso a 7-Mac di aprire questi: %@. Riprova da Impostazioni › Apertura."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS liet 7-Mac deze niet openen: %@. Probeer het opnieuw via Instellingen › Openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie pozwolił 7-Mac otworzyć tych elementów: %@. Spróbuj ponownie w Ustawieniach › Otwieranie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não deixou o 7-Mac abrir estes: %@. Tente novamente em Definições › Abertura."
          }
        }
