    "The 7-Zip engine is in SevenZipKit.framework, inside the app, and is covered by these terms. It is linked dynamically, so it can be replaced with another build of the same library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 7-Zip-Engine befindet sich in SevenZipKit.framework innerhalb der App und unterliegt diesen Bedingungen. Sie ist dynamisch gelinkt und kann daher durch einen anderen Build derselben Bibliothek ersetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor de 7-Zip está en SevenZipKit.framework, dentro de la app, y está sujeto a estas condiciones. Se enlaza dinámicamente, así que puede sustituirse por otra compilación de la misma biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur 7-Zip se trouve dans SevenZipKit.framework, à l’intérieur de l’app, et est couvert par ces conditions. Il est lié dynamiquement, il peut donc être remplacé par une autre compilation de la même bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore 7-Zip si trova in SevenZipKit.framework, dentro l’app, ed è coperto da questi termini. È collegato dinamicamente, quindi può essere sostituito con un’altra build della stessa libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 7-Zip-engine zit in SevenZipKit.framework, in de app, en valt onder deze voorwaarden. Hij is dynamisch gekoppeld, zodat hij kan worden vervangen door een andere build van dezelfde bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silnik 7-Zip znajduje się w SevenZipKit.framework wewnątrz aplikacji i podlega tym warunkom. Jest dołączany dynamicznie, więc można go zastąpić inną kompilacją tej samej biblioteki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor 7-Zip está em SevenZipKit.framework, dentro da app, e está abrangido por estes termos. Está ligado dinamicamente, por isso pode ser substituído por outra compilação da mesma biblioteca."
          }
        }
      }
    },
    "The app itself: its interface and the Swift code around the engine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App selbst: ihre Oberfläche und der Swift-Code rund um die Engine."
