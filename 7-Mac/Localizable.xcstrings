    "Folders protected by macOS itself, such as the Photos library, stay closed to every app whatever you allow here. 7-Mac skips them and says so." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas protegidas por el propio macOS, como la fototeca, siguen cerradas para todas las apps, permitas lo que permitas aquí. 7-Mac las omite y lo indica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers protégés par macOS lui-même, comme la photothèque, restent fermés à toutes les apps quoi que vous autorisiez ici. 7-Mac les ignore et le signale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle protette da macOS stesso, come la libreria di Foto, restano chiuse a tutte le app qualunque cosa autorizzi qui. 7-Mac le salta e lo segnala."
          }
        }
      }
    },
    "Forget All Folders" : {
      "localizations" : {
        "es" : {
