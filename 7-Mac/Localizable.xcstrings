    "Double-clicking a .zip, .7z, .rar or any other archive 7-Mac can read will open it here. Disc images keep opening as they do now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Doppelklick auf eine .zip-, .7z-, .rar- oder eine andere Archivdatei, die 7-Mac lesen kann, öffnet sie hier. Disk-Images werden weiterhin wie bisher geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer doble clic en un .zip, .7z, .rar o cualquier otro archivo comprimido que 7-Mac sepa leer, se abrirá aquí. Las imágenes de disco se siguen abriendo como hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un double-clic sur un .zip, un .7z, un .rar ou toute autre archive que 7-Mac sait lire l’ouvrira ici. Les images disque continuent de s’ouvrir comme maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facendo doppio clic su un .zip, .7z, .rar o qualsiasi altro archivio che 7-Mac sa leggere, si aprirà qui. Le immagini disco continuano ad aprirsi come adesso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dubbelklikt op een .zip, .7z, .rar of een ander archief dat 7-Mac kan lezen, wordt het hier geopend. Schijfkopieën worden nog steeds geopend zoals nu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwukrotne kliknięcie pliku .zip, .7z, .rar lub innego archiwum, które 7-Mac potrafi odczytać, otworzy go tutaj. Obrazy dysków będą otwierane tak jak dotąd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazer duplo clique num .zip, .7z, .rar ou em qualquer outro arquivo que o 7-Mac consiga ler irá abri-lo aqui. As imagens de disco continuam a abrir como até agora."
          }
        }
      }
    },
