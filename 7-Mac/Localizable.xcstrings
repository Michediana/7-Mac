        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo que o contém comprime o seu conteúdo, por isso este foi extraído primeiro"
          }
        }
      }
    },
    "The archive will not even open without the password." : {
