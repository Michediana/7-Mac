    "Format, level, method, dictionary, solid blocks and threads are saved. A preset with the same name is replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format, Stufe, Methode, Wörterbuch, Solid-Blöcke und Threads werden gesichert. Eine Voreinstellung mit demselben Namen wird ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan el formato, el nivel, el método, el diccionario, los bloques sólidos y los hilos. Un preajuste con el mismo nombre se sustituye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le format, le niveau, la méthode, le dictionnaire, les blocs solides et les threads sont enregistrés. Un préréglage du même nom est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono salvati formato, livello, metodo, dizionario, blocchi solid e thread. Un preset con lo stesso nome viene sostituito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formaat, niveau, methode, woordenboek, solide blokken en threads worden bewaard. Een voorinstelling met dezelfde naam wordt vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowywane są format, poziom, metoda, słownik, bloki ciągłe i wątki. Ustawienie o tej samej nazwie zostanie zastąpione."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São guardados o formato, nível, método, dicionário, blocos sólidos e threads. Uma predefinição com o mesmo nome é substituída."
          }
        }
      }
    },
