    "Right-click files in the Finder to extract, open, test or compress them with 7-Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en los archivos del Finder para extraerlos, abrirlos, probarlos o comprimirlos con 7-Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur des fichiers dans le Finder pour les extraire, les ouvrir, les tester ou les compresser avec 7-Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro sui file nel Finder per estrarli, aprirli, verificarli o comprimerli con 7-Mac."
          }
        }
      }
    },
    "Right-click files in the Finder to extract, open, test or compress them with 7-Mac. The switch is in System Settings, under Login Items & Extensions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en archivos del Finder para extraerlos, abrirlos, verificarlos o comprimirlos con 7-Mac. El interruptor está en Ajustes del Sistema, en Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez avec le bouton droit sur des fichiers dans le Finder pour les extraire, les ouvrir, les vérifier ou les compresser avec 7-Mac. Le réglage se trouve dans Réglages Système, sous Ouverture et extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro sui file nel Finder per estrarli, aprirli, verificarli o comprimerli con 7-Mac. L’interruttore è in Impostazioni di Sistema, in Elementi login ed estensioni."
          }
        }
      }
    },
