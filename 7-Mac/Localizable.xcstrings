    "Dropping an archive on the 7-Mac window always extracts it. File › Open… always shows its contents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Archiv, das auf das 7-Mac-Fenster gezogen wird, wird immer entpackt. „Ablage“ › „Öffnen …“ zeigt immer seinen Inhalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soltar un archivo comprimido en la ventana de 7-Mac siempre lo extrae. Archivo › Abrir… siempre muestra su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposer une archive sur la fenêtre de 7-Mac l’extrait toujours. Fichier › Ouvrir… affiche toujours son contenu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascinare un archivio sulla finestra di 7-Mac lo estrae sempre. File › Apri… ne mostra sempre il contenuto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een archief dat je op het 7-Mac-venster sleept, wordt altijd uitgepakt. Archief › Open… toont altijd de inhoud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwum upuszczone na okno 7-Mac jest zawsze rozpakowywane. Plik › Otwórz… zawsze pokazuje jego zawartość."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largar um arquivo na janela do 7-Mac extrai-o sempre. Ficheiro › Abrir… mostra sempre o seu conteúdo."
          }
        }
      }
    },
