    "Double-clicking a .zip, .7z, .rar or any other archive 7-Mac can read will open it here. Disc images keep opening as they do now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer doble clic en un .zip, .7z, .rar o cualquier otro archivo comprimido que 7-Mac sepa leer, se abrirá aquí. Las imágenes de disco se siguen abriendo como hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un double-clic sur un .zip, un .7z, un .rar ou toute autre archive que 7-Mac sait lire l’ouvrira ici. Les images disque continuent de s’ouvrir comme maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facendo doppio clic su un .zip, .7z, .rar o qualsiasi altro archivio che 7-Mac sa leggere, si aprirà qui. Le immagini disco continuano ad aprirsi come adesso."
          }
        }
      }
    },
    "Downloads" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
