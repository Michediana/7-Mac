    "To change “%@”, 7-Mac needs permission to write into the folder it is in. Choose “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um „%1$@“ zu ändern, benötigt 7-Mac die Erlaubnis, in den Ordner zu schreiben, in dem es liegt. Wähle „%2$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To change “%1$@”, 7-Mac needs permission to write into the folder it is in. Choose “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para modificar “%1$@”, 7-Mac necesita permiso para escribir en la carpeta que lo contiene. Elige “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour modifier « %1$@ », 7-Mac a besoin d’une autorisation pour écrire dans le dossier qui le contient. Choisissez « %2$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per modificare “%@”, 7-Mac ha bisogno del permesso di scrivere nella cartella che lo contiene. Scegli “%@”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om ‘%1$@’ te wijzigen, heeft 7-Mac toestemming nodig om te schrijven in de map waarin het staat. Kies ‘%2$@’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zmienić „%1$@”, 7-Mac potrzebuje uprawnień do zapisu w katalogu, w którym się znajduje. Wybierz „%2$@”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para alterar “%1$@”, o 7-Mac precisa de permissão para escrever na pasta onde se encontra. Escolha “%2$@”."
          }
        }
      }
    },
