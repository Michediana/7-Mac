    "The list of files is encrypted. Open the archive in 7-Mac to enter the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateiliste ist verschlüsselt. Öffne das Archiv in 7-Mac, um das Passwort einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de archivos está cifrada. Abre el archivo comprimido en 7-Mac para introducir la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des fichiers est chiffrée. Ouvrez l’archive dans 7-Mac pour saisir le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elenco dei file è cifrato. Apri l’archivio in 7-Mac per inserire la password."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lijst met bestanden is versleuteld. Open het archief in 7-Mac om het wachtwoord in te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista plików jest zaszyfrowana. Otwórz archiwum w 7-Mac, aby wprowadzić hasło."
